# etd-server configuration — copy to .env location of your choice or export in the launchd plist
PORT=8787
NODE_ENV=production
ETD_DB_PATH=/Users/YOUR_USER/etd-data/etd.sqlite
# Only read when the database is empty (first launch):
ETD_ADMIN_EMAIL=you@example.edu
ETD_ADMIN_PASSWORD=change-me-before-first-launch
ETD_INITIAL_GROUP=COMS
# Optional: serve a built frontend (dist/) from this server itself, with SPA
# fallback routing. Set this for a same-origin campus/VPN deployment so the
# built app defaults its API server to wherever it was loaded from — no
# VITE_ETD_API_URL build flag or ?server= invite param needed. Leave unset
# to run the API only (e.g. when the frontend is hosted elsewhere).
# ETD_STATIC_DIR=/Users/YOUR_USER/etd/dist
