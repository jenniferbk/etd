<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for automatic self-update from GitHub. Runs on a 15-minute
  interval (StartInterval 900), pulling origin/main, rebuilding if changed,
  restarting the server agent, and rolling back if the health check fails.
  See server/README.md, "Automatic updates from GitHub" for setup.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.etd.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/EDIT-ME/path/to/etd/server/deploy/update.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/EDIT-ME/path/to/node/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- PATH must include the directory containing node, e.g. ~/.nvm/versions/node/vXX/bin -->
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>/EDIT-ME/path/to/etd-data/update.log</string>
  <key>StandardErrorPath</key><string>/EDIT-ME/path/to/etd-data/update.err.log</string>
</dict>
</plist>
